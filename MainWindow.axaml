<Window
    x:Class="NetWatcher.App.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:NetWatcher.App"
    x:DataType="vm:MainWindowViewModel"
    Width="920"
    Height="640"
    MinWidth="720"
    MinHeight="440"
    Title="NetWatcher"
    Background="{Binding WindowBackground}"
    Foreground="#E8EEF5"
    ShowInTaskbar="True"
    mc:Ignorable="d">
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border Background="{Binding ChromeBackground}" BorderBrush="{Binding PanelBorder}" BorderThickness="0,0,0,1" Padding="20,14">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock FontSize="17" FontWeight="SemiBold" Text="NetWatcher" />
          <TextBlock FontSize="12" Foreground="{Binding MutedTextBrush}" Text="即時網路速度與程式限速" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <Border Width="8" Height="8" CornerRadius="4" Background="{Binding ConnectionStatusBrush}" VerticalAlignment="Center" />
          <TextBlock FontSize="12" Foreground="{Binding SecondaryTextBrush}" Text="{Binding NetworkLinkText}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#3A2810" BorderBrush="#A16207" BorderThickness="1" CornerRadius="10" Padding="14,10"
            Margin="16,12,16,0" IsVisible="{Binding NeedsAdminForLimits}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="2">
          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#FBBF24" Text="限速需要系統管理員權限" />
          <TextBlock FontSize="11" Foreground="#FDE68A" Text="以系統管理員重新啟動後，才能套用程式的下載與上傳限制。" />
        </StackPanel>
        <Button Grid.Column="1" Classes="ui-toolbar" Content="以系統管理員重新啟動"
                VerticalAlignment="Center" Click="RestartAsAdminButton_OnClick" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,12">
      <StackPanel Spacing="14">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <Border Classes="ui-card" Background="{Binding DownloadCardBackground}" Padding="18,16">
            <StackPanel Spacing="7">
              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{Binding DownloadAccentBrush}" Text="↓ 下載速度" />
              <TextBlock FontSize="34" FontWeight="SemiBold" FontFamily="Segoe UI, Consolas, monospace"
                         Foreground="{Binding DownloadAccentBrush}" Text="{Binding TotalDownloadSpeedText}" />
              <TextBlock FontSize="11" Foreground="{Binding MutedTextBrush}" Text="即時總下載速度 · MB/s" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="ui-card" Background="{Binding UploadCardBackground}" Padding="18,16">
            <StackPanel Spacing="7">
              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{Binding UploadAccentBrush}" Text="↑ 上傳速度" />
              <TextBlock FontSize="34" FontWeight="SemiBold" FontFamily="Segoe UI, Consolas, monospace"
                         Foreground="{Binding UploadAccentBrush}" Text="{Binding TotalUploadSpeedText}" />
              <TextBlock FontSize="11" Foreground="{Binding MutedTextBrush}" Text="即時總上傳速度 · MB/s" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Classes="ui-card">
          <Grid RowDefinitions="Auto,Auto,*">
            <Border Padding="16,12" BorderBrush="{Binding PanelBorder}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="2">
                  <TextBlock FontSize="15" FontWeight="SemiBold" Text="程式限速" />
                  <TextBlock FontSize="11" Foreground="{Binding MutedTextBrush}" Text="{Binding ProcessSummaryText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBox Classes="ui-filter" Width="170" Watermark="搜尋程式" Text="{Binding SearchText}" />
                  <Button Classes="ui-toolbar" Content="清除全部限速" Click="ClearAllLimitsButton_OnClick" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Row="1" Background="{Binding HeaderBackground}" Padding="16,9">
              <Grid ColumnDefinitions="2.2*,1*,1*,1.2*,1.2*,Auto" ColumnSpacing="10">
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding MutedTextBrush}" Text="程式" />
                <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="{Binding DownloadAccentBrush}" Text="下載 MB/s" />
                <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Foreground="{Binding UploadAccentBrush}" Text="上傳 MB/s" />
                <TextBlock Grid.Column="3" FontSize="11" FontWeight="SemiBold" Foreground="{Binding MutedTextBrush}" Text="下載限速" />
                <TextBlock Grid.Column="4" FontSize="11" FontWeight="SemiBold" Foreground="{Binding MutedTextBrush}" Text="上傳限速" />
                <TextBlock Grid.Column="5" FontSize="11" FontWeight="SemiBold" Foreground="{Binding MutedTextBrush}" Text="啟用" />
              </Grid>
            </Border>

            <Grid Grid.Row="2" MinHeight="200">
              <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Processes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProcessTrafficViewModel">
                      <Border Classes="ui-process-row" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="#14FFFFFF">
                        <Grid ColumnDefinitions="2.2*,1*,1*,1.2*,1.2*,Auto" ColumnSpacing="10">
                          <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="7" Background="{Binding AvatarBrush}">
                              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="White" Text="{Binding Initial}" />
                            </Border>
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Text="{Binding ProcessName}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="Consolas, monospace" FontSize="12" Foreground="#60A5FA" Text="{Binding DownloadSpeedText}" />
                          <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="Consolas, monospace" FontSize="12" Foreground="#4ADE80" Text="{Binding UploadSpeedText}" />
                          <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Center">
                            <ComboBox Classes="ui-limit" ItemsSource="{Binding LimitOptions}" SelectedItem="{Binding SelectedDownloadLimit}" HorizontalAlignment="Stretch" IsTextSearchEnabled="False" MaxDropDownHeight="320" ToolTip.Tip="預設限速；最下方可選「自訂…」" />
                            <TextBox Classes="ui-limit-custom" Watermark="自訂 MB/s" Text="{Binding DownloadLimitMbpsText}" ToolTip.Tip="自行輸入 MB/s，例如 3 或 0.8" />
                          </StackPanel>
                          <StackPanel Grid.Column="4" Spacing="4" VerticalAlignment="Center">
                            <ComboBox Classes="ui-limit" ItemsSource="{Binding LimitOptions}" SelectedItem="{Binding SelectedUploadLimit}" HorizontalAlignment="Stretch" IsTextSearchEnabled="False" MaxDropDownHeight="320" ToolTip.Tip="預設限速；最下方可選「自訂…」" />
                            <TextBox Classes="ui-limit-custom" Watermark="自訂 MB/s" Text="{Binding UploadLimitMbpsText}" ToolTip.Tip="自行輸入 MB/s，例如 3 或 0.8" />
                          </StackPanel>
                          <ToggleSwitch Grid.Column="5" Classes="ui-switch" IsChecked="{Binding IsLimitControlEnabled}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="啟用或停用此程式的限速" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5" IsVisible="{Binding HasNoProcesses}">
                <TextBlock FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Text="尚無程式網路流量" />
                <TextBlock FontSize="12" Foreground="{Binding SecondaryTextBrush}" Text="{Binding ProcessStatusText}" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="3" Background="{Binding ChromeBackground}" BorderBrush="{Binding PanelBorder}" BorderThickness="0,1,0,0" Padding="16,8">
      <TextBlock FontSize="11" Foreground="{Binding MutedTextBrush}" Text="限速單位：MB/s · 可選預設，或於 50 MB/s 下方「自訂…」／輸入框自行輸入（例如 3 或 0.8）" />
    </Border>
  </Grid>
</Window>
